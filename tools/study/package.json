{
  "name": "study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spaced repetition + AI quiz for the amberjack learning vault",
  "bin": {
    "study": "./src/cli.ts"
  },
  "scripts": {
    "study": "node src/cli.ts",
    "serve": "node src/server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
